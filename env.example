DISCORD_TOKEN=your bot token
CLIENT_ID=your application id
# optional: your server id, makes slash commands show up instantly
GUILD_ID=
# any long random string; must match CONFIG.TagRelayKey in the script
TAG_KEY=change-me-to-something-long
# optional: comma separated Discord user ids allowed to run /clay (default: anyone with Manage Server)
ADMIN_IDS=
# on Railway/Render point this at a mounted volume, e.g. /data/data.json, or tags reset on redeploy
DATA_FILE=./data.json
